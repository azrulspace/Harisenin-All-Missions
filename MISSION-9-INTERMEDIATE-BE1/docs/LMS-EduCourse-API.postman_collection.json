{
  "info": {
    "name": "LMS EduCourse API",
    "description": "API Collection for LMS Edu Course (Mission 9)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Auth - Register Learner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"fullName\": \"Learner Test\",\n    \"email\": \"new_learner@test.com\",\n    \"password\": \"password123\",\n    \"phoneNumber\": \"08123456789\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/v1/auth/register",
              "host": [
                "http://localhost:5000"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Auth - Login Learner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"learner.dkv@idn.sch.id\",\n    \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/v1/auth/login",
              "host": [
                "http://localhost:5000"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Auth - Login Super Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin.dkv@idn.sch.id\",\n    \"password\": \"admin123dkv\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/v1/auth/login",
              "host": [
                "http://localhost:5000"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "Courses - Get All Public Courses",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/api/v1/courses",
              "host": [
                "http://localhost:5000"
              ],
              "path": [
                "api",
                "v1",
                "courses"
              ]
            }
          }
        },
        {
          "name": "Courses - Get Course Detail by Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/api/v1/courses/belajar-ui-ux-design-pemula",
              "host": [
                "http://localhost:5000"
              ],
              "path": [
                "api",
                "v1",
                "courses",
                "belajar-ui-ux-design-pemula"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Admin - Create Course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"categoryId\": 1,\n    \"title\": \"UI/UX Design for Beginners\",\n    \"slug\": \"ui-ux-design-beginners\",\n    \"level\": \"BEGINNER\",\n    \"status\": \"PUBLISHED\",\n    \"price\": 150000,\n    \"isFree\": false\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/v1/admin/courses",
              "host": [
                "http://localhost:5000"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "courses"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Learner",
      "item": [
        {
          "name": "Learner - Enroll Course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{learnerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"courseId\": \"{{courseId}}\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/v1/learner/enrollments",
              "host": [
                "http://localhost:5000"
              ],
              "path": [
                "api",
                "v1",
                "learner",
                "enrollments"
              ]
            }
          }
        },
        {
          "name": "Learner - Update Lesson Progress",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{learnerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"lessonId\": \"{{lessonId}}\",\n    \"isCompleted\": true,\n    \"lastWatchDuration\": 120\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/v1/learner/progress",
              "host": [
                "http://localhost:5000"
              ],
              "path": [
                "api",
                "v1",
                "learner",
                "progress"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "adminToken",
      "value": "your_admin_jwt_token_here"
    },
    {
      "key": "learnerToken",
      "value": "your_learner_jwt_token_here"
    },
    {
      "key": "courseId",
      "value": "uuid-placeholder-for-course"
    },
    {
      "key": "lessonId",
      "value": "uuid-placeholder-for-lesson"
    }
  ]
}
