    {
      "name": "Courses",
      "item": [
        {
          "name": "Get All Courses",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/api/v1/courses?search=design&sort=latest",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5000",
              "path": [
                "api",
                "v1",
                "courses"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "design"
                },
                {
                  "key": "sort",
                  "value": "latest"
                }
              ]
            }
          }
        },
        {
          "name": "Create Course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer YOUR_JWT_TOKEN"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Advanced Design\",\n  \"description\": \"Learn advanced design techniques\",\n  \"price\": 100000,\n  \"categoryId\": 1,\n  \"level\": \"ADVANCED\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/v1/courses",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5000",
              "path": [
